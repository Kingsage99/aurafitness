# Logs
logs
*.log
npm-debug.log*

# Runtime data
pids
*.pid
*.seed

# node_modules
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Vite cache
.vite/

# OS files
.DS_Store
Thumbs.db

# API keys — never commit
.env
.env.local
.env.*.local
.mcp.json

# The paid ebook deliverable itself — a purchase-gated digital product, not
# source code. Never committed: git history would defeat the payment gate
# (and the webhook-driven delivery pipeline, once built, serves it directly
# from storage rather than from this checkout).
/ebook/

# Original drop location for the ebook's marketing preview images — the
# copies that actually need to be committed live in public/ebook-preview/
# (served on the live site); this is just the untouched source duplicate,
# kept out of git to avoid committing the same ~4MB of images twice.
/images_books/

.vercel

# Playwright UX audit — real session tokens + generated artifacts, never commit
e2e/.auth/
e2e/screenshots/
e2e/findings/
e2e/AUDIT_REPORT.md

# Claude runtime state
.claude/scheduled_tasks.lock

# Symlinks into .agents/skills/ (universal skill installs) -- core.symlinks is
# off on this checkout, so `git add` would otherwise duplicate the whole skill
# as real files here instead of tracking the symlink. Source of truth is .agents/.
.claude/skills/vibe-security
